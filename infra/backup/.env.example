# Parâmetros dos scripts de backup e restauração.
#
# Não entram no schema de configuração da aplicação: o processo do IdP nunca lê nenhuma
# destas variáveis, e acrescentá-las lá faria o serviço se recusar a subir por falta de algo
# que ele não usa.
#
# Uso local:
#   cp infra/backup/.env.example infra/backup/.env
#   set -a; . infra/backup/.env; set +a
#
# Nenhum valor preenchido aqui. Este arquivo é versionado; o .env ao lado, não.

# ---------- cifra ----------
# Chave pública age, gerada por scripts/generate-backup-key.sh. Sem ela, o backup recusa
# gravar: o artefato carrega hash de senha de todos os usuários e a chave privada de
# assinatura. Formato: age1... (62 caracteres).
BACKUP_AGE_RECIPIENT=

# Caminho da identidade que decifra. Só a restauração precisa dela — o host que faz o backup
# não deve ter acesso.
BACKUP_AGE_IDENTITY_FILE=

# Só desenvolvimento: '1' assume o risco de gravar o artefato em claro. Em qualquer ambiente
# com dado real, deixe vazio e defina o destinatário acima.
BACKUP_PERMITIR_SEM_CIFRA=

# ---------- coleta ----------
POSTGRES_URL=
MONGODB_URL=
DIRETORIO_BACKUP=backups
# Piso de suspeita: dump menor que isso é tratado como falha, não como base pequena.
TAMANHO_MINIMO_BYTES=1024
# Comando que recebe o diretório e envia os artefatos para fora do host. Fica como
# configuração para trocar de provedor não virar mudança de código.
BACKUP_UPLOAD_CMD=
# JSON com o resultado da última execução; é o que o alerta de backup velho consome.
BACKUP_STATUS_FILE=

# ---------- retenção ----------
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# ---------- restauração ----------
# Nome que o banco alvo precisa ter para a restauração prosseguir. É a trava que impede
# restaurar sobre o banco errado por causa de uma URL esquecida no terminal — preencha com o
# banco de ENSAIO, nunca com o de produção.
RESTORE_TARGET_POSTGRES_DB=
RESTORE_TARGET_MONGODB_DB=

# Quebra-vidro para restaurar sobre produção. Deixe vazio: definir aqui anula a trava para
# toda execução futura neste ambiente. O lugar dela é a linha de comando, uma vez.
RESTORE_ALLOW_PRODUCTION=

# ---------- verificação ----------
# Segredo mestre do ambiente restaurado. Divergente da origem, os dados voltam e as chaves de
# assinatura não — a verificação reprova em `chave`, e é assim que se descobre.
MASTER_KEY=
# Conta de canário: prova que o hash de senha sobreviveu íntegro à cópia. Só ambientes de
# ensaio; produção é verificada pelos outros pontos, que não exigem conhecer senha.
CANARY_EMAIL=
CANARY_PASSWORD=
