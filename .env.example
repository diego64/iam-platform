# Contrato de ambiente da aplicação.
# Copie para .env e preencha. NUNCA versione o .env preenchido.
#
# As variáveis sem default são obrigatórias: a ausência de qualquer uma derruba o
# processo no boot, antes de abrir socket (src/config/env.ts).

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Teto do encerramento gracioso; estourou, o processo sai com código 1.
SHUTDOWN_TIMEOUT_MS=10000

# Prontidão (/health/ready)
# Janela do cache do resultado positivo; 0 desliga.
HEALTH_CACHE_MS=2000
# Teto por dependência. Precisa ser menor que o timeout da sonda do orquestrador.
HEALTH_TIMEOUT_MS=1000

# PostgreSQL: usuários, RBAC, JWKS
# OBRIGATÓRIA. Precisa começar com postgres:// ou postgresql://
POSTGRES_URL=
POSTGRES_POOL_MAX=10
# Certificado da CA (PEM) para verificar o TLS do Postgres gerenciado (ex.: Render), quando o
# certificado do provedor não está no bundle do sistema. Vazio = verifica com as CAs do sistema.
POSTGRES_CA_CERT=

# MongoDB: refresh tokens, denylist, auditoria
# OBRIGATÓRIA. Precisa começar com mongodb:// ou mongodb+srv://
MONGODB_URL=
MONGODB_DB=iam_sessions

# Chaves e JWT
# Par Ed25519 em PEM, base64. Gerar com: pnpm tsx scripts/generate-keys.ts
# Só entra por env/secret manager. Proibido .pem no repositório.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ACTIVE_KID=
JWT_ISSUER=https://iam.example.com
JWT_AUDIENCE=iam-clients
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token: validade deslizante por token (idle) renovada na rotação, teto absoluto por
# família que a rotação nunca estende, e janela de graça para não confundir rotação
# concorrente legítima com reuso (roubo).
REFRESH_TOKEN_TTL_MS=604800000
REFRESH_TOKEN_ABSOLUTE_TTL_MS=2592000000
REFRESH_REUSE_GRACE_MS=10000
# Segredo que decifra a chave privada de assinatura em repouso (envelope AES-256-GCM).
# Necessária para assinar e rotacionar; ausente, o serviço só sobe se ainda não houver
# chave. Mínimo 32 caracteres. Só via secret manager — nunca preenchida aqui.
MASTER_KEY=
# Janela de graça (ms) em que uma chave aposentada ainda verifica tokens. Default 15 min.
JWKS_GRACE_PERIOD_MS=900000
# TTL de segurança (ms) do cache do conjunto de chaves. Default 5 min.
# Precisa ser MENOR que JWKS_GRACE_PERIOD_MS, senão o boot aborta: durante a rotação, a
# réplica com cache velho assina com a chave recém-aposentada, e esses tokens só valem
# enquanto ela estiver na graça.
JWKS_CACHE_TTL_MS=300000
# Tempo (ms) que a chave pré-publicada fica no JWKS antes de poder assinar. Default 10 min
# = cache das réplicas (5 min) + max-age do endpoint JWKS (5 min).
JWKS_PREPUBLISH_MIN_MS=600000
# Idade (ms) a partir da qual a chave ativa é rotacionada sozinha. Default 30 dias.
JWKS_ROTATION_MAX_AGE_MS=2592000000
# Intervalo (ms) entre verificações do agendador de rotação. Default 1 h.
JWKS_ROTATION_CHECK_INTERVAL_MS=3600000
# Margem (ms) após o fim da verificabilidade antes de apagar a chave. Default 24 h.
JWKS_PURGE_AFTER_MS=86400000
# Liga o agendador de rotação. Desligado, a rotação só acontece pela API administrativa.
JWKS_ROTATION_ENABLED=true

# Senhas
SCRYPT_COST=32768
SCRYPT_BLOCK_SIZE=8
SCRYPT_PARALLELIZATION=1

# Bootstrap do primeiro admin. Opcionais: definidos, o server cria o admin
# inicial na subida (idempotente). A senha é secret — venha do secret manager, nunca
# preenchida aqui. Ausentes, nada acontece.
IAM_BOOTSTRAP_ADMIN_EMAIL=
IAM_BOOTSTRAP_ADMIN_PASSWORD=

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000

# Observabilidade
# Ausente/vazia desliga o pipeline de traces. Em produção, aponte para rede interna.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=iam-platform
# Proporção de traces amostrada (0 a 1). 1 em desenvolvimento, 0.1 em produção.
OTEL_TRACES_SAMPLER_ARG=1
# Registra GET /metrics e sobe o exportador. false | 0 | no | off desligam.
METRICS_ENABLED=true
# Libera /metrics fora de rede interna. Manter false: o endpoint expõe topologia,
# nomes de rota e volume de tráfego.
METRICS_PUBLIC=false
# Commit da imagem, rótulo de iam_build_info. Injetado pelo CD como build arg;
# fora dele fica "desconhecido", que é mais honesto que um valor inventado.
GIT_COMMIT=desconhecido
